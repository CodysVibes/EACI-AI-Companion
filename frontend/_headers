# Cloudflare Pages — security, content-type, and cache
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()

/
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8
  X-Content-Type-Options: nosniff
  Vary: Accept
  Link: </.well-known/api-catalog>; rel="api-catalog", </docs/api.md>; rel="service-doc", </docs/api/openapi.json>; rel="service-desc", </.well-known/oauth-protected-resource>; rel="oauth-protected-resource", </.well-known/openid-configuration>; rel="openid-configuration", </auth.md>; rel="describedby", </llms.txt>; rel="describedby", </.well-known/agent-skills/index.json>; rel="agent-skills", </.well-known/mcp/server-card.json>; rel="mcp-server-card"

